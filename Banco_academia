FROM Alunos;

--QUANTIDADE DE MASTRICULAS QUE JA POSSUEM NOTA FINAL
SELECT COUNT(NotaFinal) AS QuantidadeDeMatriculasComNota
FROM Matriculas;

--MEDIA, MAIOR E MENOR NOTA; OBS: DADOS NULOS (NULL) NÃO SÃO CONSIDERADOS NOS CÁLCULOS
SELECT 
AVG(NotaFinal) AS MediaDasNotas, -- media das notas 
MAX(NotaFinal) AS MaiorNota, -- maior nota
MIN(NotaFinal) AS MenorNota -- menor nota
FROM Matriculas;

-- TROCA NULL POR UM TEXTO PARA EXIBIR O RESULTADO DE FORMA MAIS CLARA
SELECT
IdMatricula, ISNULL(CONVERT(VARCHAR(10), NotaFinal), 'Sem Nota') AS NotaFinal, StatusMatricula 
FROM Matriculas;

--GROUP BY E HAVING: AGRUPA OS REGISTROS POR UMA OU MAIS COLUNAS E PERMITE FILTRAR OS GRUPOS COM BASE EM UMA CONDIÇÃO
                                                               
-- QUANTOS ALUNOS ESTÃO MATRICULADOS EM CADA TURMA
SELECT Turma, COUNT(*) AS QunatidadeDeAlunos
FROM Alunos
GROUP BY Turma
ORDER BY QunatidadeDeAlunos DESC; -- ORDENA O RESULTADO PELA DE ALUNOS EM ORDEM DECRESCENTE

-- CURSOS QUE TEM DUAS OU MAIS MATRICULAS
SELECT IdCurso, COUNT(*) AS QuantidadeDeMatriculas
FROM Matriculas
GROUP BY Id_Cursos
HAVING COUNT (*) >= 2 -- FILTRA OS CURSOS QUE TEM DUAS OU MAS MATRICULAS
ORDER BY QuantidadeDeMatriculas DESC; -- ORDENA O RESULTADO PELA QUANTIDADE DE MATRICULAS EM ORDEM DECRESCENTE

-- RELACIONANDO TABELAS COM JOIN: permite combinar registros de duas ou mais tabelas com base em uma condição de correspondencia

-- INNER JOIN: retorna apenas os registros que tem correspondencia em ambas as tabelas

SELECT
a.Nome AS NomeDoAluno,
c.Nome_Curso AS NomeDocurso,
m.NotaFinal,
m.StatusMatricula
FROM Matriculas AS m
INNER JOIN Alunos AS a
ON m.IdAluno = a.IdAluno -- relaciona a tabela matricula com a tabela alunos
INNER JOIN Cursoss AS c
ON m.Id_Cursos = c.Id_Cursos -- relaciona a tabela matricula com a tabela cursoss
ORDER BY a.Nome; -- ordena o resultado pelo nome do aluno


SELECT 
a.Nome AS Aluno,
a.Turma,
c.Nome_Curso AS Curso,
p.Nome AS Professores,
m.NotaFinal,
m.StatusMatricula
FROM Matriculas AS m 
INNER JOIN Alunos AS a 
ON m.IdAluno = a.IdAluno -- relaciona a tabela mattriculuas com a tabel alunos
INNER JOIN Cursoss AS c 
ON m.Id_Cursos = c.Id_Cursos -- relaciona a tabela matricula com a tabela cursos
INNER JOIN Professores AS p   
ON c.Id_Professores = p.Id_Professores -- relaciona a tabela cursos com a atbela professores
Order by p.Nome, c.Nome_Curso, a.Nome; -- ordena o resultado pelo nome do aluno

--LEFT JOIN: RETORNA TODOS OS REGISTROS DA TABELA Á ESQUERDA  E OS REGISTROS CORRESPONDENTES DA TABELA Á DIRETA. SE NÃO HOUVER CORRESPONDENCIA, OS VALORES DA TABELA SERÃO NULOS

SELECT
a.Nome AS NomeDoAluno,
c.Nome_Curso AS NomoDoCurso,
m.NotaFinal,
m.StatusMatricula
FROM Alunos AS a 
LEFT JOIN Matriculas AS m 
ON a.IdAluno = m.IdAluno -- relaciona a tabela alunos com a tabela matriculas
LEFT JOIN Cursoss AS c  
ON m.Id_Cursos = c.Id_Cursos -- relaciona a tabela matriculas com a tabela cursos
WHERE m.IdMatricula IS NULL -- filtra os alunos que não possuem matricula

-- SE A CONSULTA NAO RETORNAR LINHAS, SIGNIFICA QUE TODOS OS ALUNOS POSSUEM MATRICULAS EM APENAS UM CURSO

-- JOIN COM FILTRO E MÉDIA POR CURSO: retorna a media das notas finais por curso, considerando apenas os alunos que possuem matricula

SELECT
c.NomeCurso AS Curso,
COUNT(m.IdMatricula) AS TotalDeMatriculas,
AVG(m.NotaFinal) AS mediaDoCurso
FROM Cursoss AS c 
LEFT JOIN Matriculas AS m 
ON c.Id_Cursos = m.Id_Cursos -- RELACIONA A TABELA CURSOS COM A TABELA MATRICULA
WHERE m.NotaFinal IS NOT NULL -- FILTRA O RESULTADO PELO NOME DO CURSO
GROUP BY c.NomeCurso -- AGRUPA O RESULTADO PELO NOME DO CURSO
ORDER BY c.NomeCurso; -- ORDENA O RESULTADO PELO NOME DO CURSO



-- crinado tabela professores
CREATE TABLE Professores(
    Id_Professores INT PRIMARY KEY IDENTITY(1,1), -- IDENTIFICADOR  PARA AUTOINCREMENTAR O ID DO PROFESSOR
    Nome VARCHAR(100) NOT NULL,
    Email VARCHAR(100) NOT NULL UNIQUE, -- UNIQUE PARA NÃO PERMITIR  MAIS DE UM EMAILS
    Especialidade VARCHAR(100) NOT NULL

);

CREATE TABLE Cursoss(
    Id_Cursos INT PRIMARY KEY IDENTITY(1,1),
    Nome_Curso VARCHAR(100) NOT NULL UNIQUE, -- UNIQUE PARA NAO PERMITIR CURSOS DUPLICADOS
    CaragaHorario INT NOT NULL CHECK (CaragaHorario > 0 AND CaragaHorario <= 200), -- CHECK- CONDICIONAL PARA VALIDAR A CARGA HORARIA
    Id_Professores INT NOT NULL,
    Ativo BIT NOT NULL DEFAULT 1, -- DEFAULT PARA EDEFINIR O VALOR PADRAO COMO 1 (ATIVO)

     CONSTRAINT FK_Cursos_Professores --CONSTRAINT para criar a chave estrangeira
    FOREIGN KEY (Id_Professores) REFERENCES Professores(Id_Professores)  
);

CREATE TABLE Alunos(
    IdAluno INT PRIMARY KEY IDENTITY(1,1),
    Nome VARCHAR(100) NOT NULL,
    Email VARCHAR(100) NOT NULL UNIQUE,
    Turma VARCHAR(50) NOT NULL,
    DataNascimento DATE NOT NULL,
    Ativo BIT NOT NULL CONSTRAINT DF_Alunos_Ativo DEFAULT 1,

) ;    


select * from Professores;
select * from Cursoss;
select * from Alunos;

-- visualizar todas as tabelas do banco de dados banco_academia
SELECT TABLE_NAME
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_TYPE = 'BASE TABLE'

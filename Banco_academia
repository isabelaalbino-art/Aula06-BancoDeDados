--FILTROS COM WERE
--WHERE FILTRARA AS LINHAS. LEIA A CONSULTA COMO UMA FRASE: SELECIONE OS NOMES E TURMAS DOS ALUNOS ONDE A TURMA SEJA IGUAL A "2INFO-A"
--IGUAL A
select Nome, Turma
from Alunos
WHERE Turma = '2INFO-A';

-- DIFERENTE DE
SELECT Nome, Turma 
from Alunos
where Turma <> '2INFO-A'; -- OU SEJA, SELEECIONE OS NOME E TURMAS DOS ALUNOS ONDE A TURMA SEJA DIFRENTE DE '2INFO-A'

-- AND -> AS DUAS CONDICOES DEVEM SER VERDADEIRAS PARA QUE O REGISTRO SEJA RETORNADO NA CONSULTA

Select Nome, Turma, DataNascimento
FROM Alunos 
where Turma = '2INFO-A' AND DataNascimento > '2008-01-01'; -- OU SEJA, SLECIONE OS NOMES, TURMAS E DATAS DE NASCIMENTO DOS ALUNOS ONDE A TURMA SEJA IGUAL A '2INFO-A' E A DATA DE NASCIMENTO SEJA MAIOR QUE '2008-01-01'

--OR: PELO MENOS UMA CONDICAO DEVE SER VERDADEIRA
SELECT Nome, Turma
FROM Alunos
where Turma = '2INFO-A' OR DataNascimento > '2008-01-01'; -- OU SEJA, SLECIONE OS NOMES E TURMAS DOS ALUNOS ONDE A TURMA DEJA IGUAL A "2INFO-A" OU A DATA DE NASCIEMNTO SEJA MAIOR QUE 2008-01-01

--IN: VERSÃO MAIS CURTA PARA VARIOS VALORES 
SELECT Nome, Turma
FROM Alunos
WHERE Turma IN ('2INFO-A', '2INFO-B');  -- OU SEJA , SEKLECIONE OS NOMES E TURMAS DOS ALUNOS ONDE A TURMA SEJA IGUAL A '2INFO-A'OU '2INFO-B'



-- FUNÇÕES DE ETXTO E DATA 
SELECT 
Nome, 
UPPER(Nome) AS NomeEmMaisculo, -- CONVERTER O NOME PARA MAISUCULO
LOWER(Nome) AS NomeEmMinusculo, -- CONVERTE O NOME PARA MINUSCULO
LEN(Nome) AS QuantidadeDeCaracteres, -- Retorna a qauntidade de caracteres do nome
CONCAT(Nome,' - ', Turma) AS NomeETurma, -- concatena o nome e a turMA
FORMAT(DataNascimento, 'dd/MM/yyyy') AS DataNascimentoFormatada,-- fromata data
DATEDIFF(YEAR, DataNascimento, GETDATE()) AS IdadeAproximada -- calcula a idade do aluno
FROM Alunos;

